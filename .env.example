# docker-compose.prod.yml 용 환경 변수. 복사해서 .env로 저장 후 값 채우기.
# 로컬 실행(./gradlew bootRun)에서 S3 모드를 쓸 때도 같은 이름의 환경 변수를 넘긴다 (README 참고).
# .env는 절대 커밋하지 않는다.

DB_PASSWORD=change-me

# local | s3
STORAGE_MODE=s3
S3_BUCKET=work-841820566166-us-east-1-an
S3_REGION=us-east-1
S3_PREFIX=uploads/

# S3 자격 증명. 둘 다 채우면 이 값을 그대로 사용하고, 둘 다 비우면 SDK 기본 체인(EC2 인스턴스 역할)을 쓴다
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# APP_PORT=8080
